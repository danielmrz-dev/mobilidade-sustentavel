# Copie este arquivo para .env e ajuste os valores.
# O docker compose le o .env automaticamente.

# Senha do usuario SYS/SYSTEM do container Oracle
ORACLE_PASSWORD=OracleSys123

# Usuario/schema da aplicacao
DB_USERNAME=mobilidade
DB_PASSWORD=mobilidade123

# Para usar o Oracle da faculdade em vez do container, rode a API fora do compose
# e defina tambem a URL, por exemplo:
# DB_URL=jdbc:oracle:thin:@host-do-oracle:1521/ORCL

# Chave do JWT em Base64 (minimo 32 bytes). Gere uma com: openssl rand -base64 48
JWT_SECRET=bW9iaWxpZGFkZS1zdXN0ZW50YXZlbC1jaGF2ZS1zZWNyZXRhLWRlLWRlc2Vudm9sdmltZW50by0yMDI2
JWT_EXPIRATION_MS=7200000

# Primeiro usuario ADMIN, criado automaticamente na inicializacao
ADMIN_EMAIL=admin@mobilidade.com
ADMIN_SENHA=Admin@123
